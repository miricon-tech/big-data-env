# --- Git LFS: קבצים כבדים ---
*.parquet filter=lfs diff=lfs merge=lfs -text
*.jar     filter=lfs diff=lfs merge=lfs -text
*.pt      filter=lfs diff=lfs merge=lfs -text
*.onnx    filter=lfs diff=lfs merge=lfs -text
# אם יש CSV כבדים בלבד:
# *.csv     filter=lfs diff=lfs merge=lfs -text

# --- טקסט: נרמול לקצות שורה LF ---
* text=auto eol=lf

# --- קבצים בינאריים שאין טעם לעשות להם diff ---
*.png binary
*.jpg binary
*.jpeg binary

# אופציונלי: מחלישים diff לנוטבוקים (אם לא משתמשים בכלי ייעודי)
*.ipynb -diff